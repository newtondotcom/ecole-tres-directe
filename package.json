{
  "name": "etd",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/bun": "^1.4.0",
      "hono": "^4.13.3",
      "@trpc/server": "^11.18.0",
      "lucide-react": "^1.33.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.5",
      "@trpc/client": "^11.18.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "tailwindcss": "^4.3.3",
      "typescript": "^6.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "compile:server": "turbo -F server compile",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@etd/env": "workspace:*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@etd/config": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "turbo": "^2.10.11",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.3"
}
